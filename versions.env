# The pinned stack. Never `latest` — a green run must say WHICH images it
# verified, or it says only that something, somewhere, worked.
#
# The emulator images are versioned INDEPENDENTLY. That is not an oversight to
# tidy up: fabric-emulator and its companions are on different version lines
# and ship on their own cadences, so they will not agree and are not meant to.
# A consumer has to pin every one of them, and discovering that is part of what
# this repository is for. No count is written here on purpose — the list below
# is the list, and a number in the prose is one more thing to get wrong when a
# member joins.
#
# docker compose reads this directly via --env-file, so the names here are the
# variable names the compose files use — one file, no translation layer.
# DIGESTS, not just tags, for the three images a fabric-emulator release
# retags. `emulator-sail:X` and `emulator-spark-agent:X` are named for the
# dependency a consumer pins them FOR, not for their content: both also carry
# first-party code that changes independently, so two releases can publish the
# same tag over different bytes. fabric-emulator enforces @sha256 on every
# reference to them inside its own repository (scripts/check_image_digests.py)
# and this stack is the consumer that was not covered.
#
# The digests are rewritten by scripts/set_release.py alongside the versions.
# They MUST move together: docker ignores the tag in `repo:tag@sha256:...`, so
# a stale digest beside a fresh tag silently tests the OLD image while the run
# summary names the new one — the exact failure set_release.py exists to
# prevent, reintroduced one level down.
FABRIC_EMULATOR_VERSION=0.34.0
FABRIC_EMULATOR_DIGEST=sha256:7383cd5fe9c597a98eac84284e6e644261a9622f5fe5fd3a90be31edf20c7908
ENTRA_EMULATOR_VERSION=0.9.0
ENTRA_EMULATOR_DIGEST=sha256:19418a503b6459d1f9db4e0d7657f78bf01655269ce7abef968fd5d1eb80da86
KEYVAULT_EMULATOR_VERSION=0.7.0
KEYVAULT_EMULATOR_DIGEST=sha256:e58e8ed3ebad1557b5b2a96280c0ec7ebbd92151183ca6539c89435f29ab1def

# The resource manager. A Fabric capacity is an ARM resource
# (`Microsoft.Fabric/capacities`), so provisioning creates one here and the
# Fabric emulator picks it up from ARM's family feed. Its own version line,
# like the rest.
ARM_EMULATOR_VERSION=0.4.1
ARM_EMULATOR_DIGEST=sha256:4a2fa5ae7abb2792b94c3d3949db829e7f82203220ee166bc5874ab1a8ac75e5

# The Spark engine. LakeSail's Sail is a Rust Spark-Connect server — PySpark
# semantics with no JVM — published by the emulator project at the same
# cadence, so it pins to the same version as fabric-emulator itself.
# SAIL_ENGINE and SPARK_CLIENT are tagged for the DEPENDENCY they carry --
# pysail and pyspark-client -- because that is what a consumer pins them for.
# They used to be pinned on the emulator's own release tag, which reads tidier
# and tells you nothing: `emulator-sail:0.33.0` does not say which Sail is
# inside, and both tags are published over the same bytes. Three fields, three
# jobs: _VERSION is the tag (what Sail you get), _DIGEST is the identity (which
# build exactly), _RELEASE is the fabric-emulator release that packaged it, read
# from the image's own org.opencontainers.image.version label.
#
# _RELEASE is DERIVED, never typed: CI re-reads the label from the pinned digest
# and fails if it disagrees, and asserts it equals FABRIC_EMULATOR_VERSION --
# which is what catches a pysail bump moving the tag out from under us.
SAIL_ENGINE_VERSION=0.7.0
SAIL_ENGINE_DIGEST=sha256:f2bc4a48b51e40ec32d82964397887554d11b44dab1ff624eff581872083b693
SAIL_ENGINE_RELEASE=0.34.0

# The statement executor the emulator drives to run a notebook. Published by the
# same release workflow and tagged with the emulator's own version, so it moves
# in lockstep — see scripts/set_release.py.
SPARK_CLIENT_VERSION=4.2.0
SPARK_CLIENT_DIGEST=sha256:7afe03dcbbf959f0b8dea0685a2435145857beddafa6feeda4c7c9f331ca49c7
SPARK_CLIENT_RELEASE=0.34.0

# THE VENDOR IMAGES ARE NOT PINNED HERE. contoso-sources pins them — the
# simulator, the ERP database, its broker and the connector — and
# scripts/sources.py reads that repo's versions.env. Two consumers on different
# mokapis are not pulling from the same vendor even if the specs match, so the
# pin belongs with the declaration rather than in each platform.

# The Warehouse engine. Fabric's Warehouse is T-SQL over TDS, and the emulator
# terminates FedAuth in front of a real SQL Server — so gold runs against an
# actual T-SQL engine rather than a stand-in.
#
# DIGEST-PINNED: this sidecar IS the warehouse engine, so an unannounced image
# change moves T-SQL behaviour under the assertions.
#
# amd64 only — Microsoft publishes no arm64 manifest. On Apple silicon the
# engine translates this one container; on an arm64 Linux host gold cannot run,
# which is a limitation of SQL Server's distribution, not of this platform.
SQLSERVER_VERSION=2022-latest
SQLSERVER_DIGEST=sha256:ba4c8329f48fb8f02e1416be6a930ebfd71268caee78aa985f3af4315e457c89

# The catalog. Heavy — OpenMetadata plus its own Postgres and OpenSearch, which
# alone wants a 1 GB heap — so it is profile-gated and `make up` never starts it.
OPENMETADATA_VERSION=1.13.2
OPENMETADATA_SERVER_DIGEST=sha256:f5cdd8b6223b47acbce76b6036a8ae802967dc297732846bedc911b05ae9d300
OPENMETADATA_PG_DIGEST=sha256:7c71755ed605fbe7f2687110b5604ff114e28d94174f3e9ae4f208780d1c805b
OPENSEARCH_VERSION=3.4.0
OPENSEARCH_DIGEST=sha256:1647ce2e07371f1ac8bbad28890a64ef77c5a694a61f656120f0ace09e66bf48
